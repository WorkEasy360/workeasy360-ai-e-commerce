# Local development configuration. Copy to .env (git-ignored) and adjust.
# Every value here is a throwaway local default for services bound to
# 127.0.0.1 by infra/docker-compose.yml. Never reuse them in any shared
# or deployed environment, and never put real credentials in this file.

NODE_ENV=development
LOG_LEVEL=info

# --- Host ports published by infra/docker-compose.yml -----------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
IDENTITY_PORT=5556

# --- PostgreSQL ---------------------------------------------------------------
# The container creates only the maintenance database; `pnpm db:setup` creates
# the app's database itself (and refuses one it didn't create).
POSTGRES_DB=postgres
POSTGRES_USER=workeasy_local
POSTGRES_PASSWORD=local-dev-only

# Superuser connection: used only by `pnpm db:setup` to create roles, the
# database and the schema, and by integration tests to create a test database.
DATABASE_ADMIN_URL=postgres://workeasy_local:local-dev-only@127.0.0.1:5432/postgres
# One URL per database role (packages/database/src/roles.ts). User names must
# match the role names; `pnpm db:setup` sets each role's password from its URL.
DATABASE_MIGRATION_URL=postgres://wec_owner:local-owner-only@127.0.0.1:5432/workeasy_commerce
DATABASE_URL=postgres://wec_api:local-api-only@127.0.0.1:5432/workeasy_commerce
DATABASE_WORKER_URL=postgres://wec_worker:local-worker-only@127.0.0.1:5432/workeasy_commerce
DATABASE_PUBLIC_URL=postgres://wec_public:local-public-only@127.0.0.1:5432/workeasy_commerce

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- S3-compatible object storage (RustFS locally) ----------------------------
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=local-dev-access
OBJECT_STORAGE_SECRET_KEY=local-dev-secret-key
OBJECT_STORAGE_BUCKET_QUARANTINE=workeasy-commerce-quarantine
OBJECT_STORAGE_BUCKET_CLEAN=workeasy-commerce-clean
OBJECT_STORAGE_BUCKET_EXPORTS=workeasy-commerce-exports
OBJECT_STORAGE_BUCKET_MEDIA=workeasy-commerce-media
# Where browsers send presigned uploads; must be reachable from the admin's browser.
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# --- Malware scanner (ClamAV clamd) -------------------------------------------
SCANNER_HOST=127.0.0.1
SCANNER_PORT=3310

# --- Application processes ----------------------------------------------------
API_PORT=4000
ADMIN_PORT=3000
STOREFRONT_PORT=3001
WORKER_POLL_INTERVAL_MS=5000
WORKER_JOB_CONCURRENCY=8
WORKER_JOB_BUDGET_MS=20000
# Worker liveness endpoint (GET /health/live).
WORKER_HEALTH_PORT=4001

# --- Sign-in (OIDC) -----------------------------------------------------------
# Local Dex provider from infra/docker-compose.yml. Fixture users and their
# password are listed in infra/dex/config.yaml. Email and password accounts
# work without it.
OIDC_ISSUER_URL=http://localhost:5556/dex
OIDC_CLIENT_ID=workeasy-commerce-admin
OIDC_CLIENT_SECRET=local-admin-client-secret
# Public origin of the merchant admin. The OIDC redirect URI is
# <origin>/auth/callback, and it is the only origin allowed to send
# cookie-authenticated mutations.
ADMIN_PUBLIC_URL=http://localhost:3000
# Public origin of the storefront app; shops live at <origin>/s/<store-slug>.
STOREFRONT_PUBLIC_URL=http://localhost:3001
# Where the admin and storefront forward /api, /auth and /public requests.
API_INTERNAL_URL=http://127.0.0.1:4000

# --- Sign-in with WorkEasy360 Accounts (docs/workeasy360-sso.md) -------------
# Off while WORKEASY360_ISSUER is empty. To try it against a WorkEasy360
# provider on this machine, register the client in Super Admin (redirect URI
# http://localhost:3000/auth/workeasy360/callback, back-channel logout
# http://localhost:3000/auth/workeasy360/backchannel-logout, post-logout
# http://localhost:3000/), put the private key in a file outside the
# repository and fill these in. Plain http is accepted only for a loopback
# issuer and never in production.
WORKEASY360_ISSUER=
WORKEASY360_CLIENT_ID=
WORKEASY360_PRODUCT_CODE=ai_commerce
WORKEASY360_REDIRECT_URI=http://localhost:3000/auth/workeasy360/callback
WORKEASY360_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
WORKEASY360_KEY_ID=
# A PEM file (RSA or EC P-256) that is never committed, e.g. ../secrets/workeasy360-commerce.pem
WORKEASY360_PRIVATE_KEY_FILE=
WORKEASY360_SCOPES=openid email profile organization
# true: WorkEasy360 is the only way into the admin (password and generic single
# sign-on off, their sessions refused). Leave false until every merchant can sign in with it.
WORKEASY360_SSO_ONLY=false
# Role for someone joining an organization's existing store; a store's creator is its owner.
WORKEASY360_DEFAULT_ROLE=staff
# false: an organization's people cannot create stores; only stores linked with
# `db link-workeasy360-organization` can be signed in to.
WORKEASY360_PROVISION_STORES=true
# Encrypts the short-lived login-transaction cookie. At least 32 characters.
SESSION_SECRET=local-dev-only-session-secret-change-me-0000
SESSION_TTL_HOURS=12
# Must be true anywhere served over HTTPS; the API refuses false in production.
SESSION_COOKIE_SECURE=false

# --- AI Studio ----------------------------------------------------------------
# "stub" is a deterministic local provider that needs no account; "openai" or
# "gemini" call that provider with the key below and AI_MODEL. "disabled"
# hides AI. Keys are read by the worker only. stub is refused in production.
AI_PROVIDER=stub
# AI Studio generations per store per day.
AI_DAILY_LIMIT=100
# Admin assistant questions per store per day. The API calls the provider
# itself for the assistant, with the same AI_PROVIDER, AI_MODEL and key.
ASSISTANT_DAILY_LIMIT=200

# Features hidden until their whole journey is tested, comma-separated:
# services (bookable services), buy_x_get_y (offers), stripe (card gateway).
# Empty = all off. Turning one off stops new setups; existing ones keep working.
COMMERCE_FEATURES=
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Payments (Phase 4) -------------------------------------------------------
# Encrypts merchants' payment-gateway credentials at rest; the API and the
# worker must share it. 32 random bytes, base64. Generate your own with:
#   node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64\"))"
SECRETS_ENCRYPTION_KEY=bG9jYWwtZGV2LW9ubHktc2VjcmV0cy1rZXktMDAwMDA=
# Public origin of the API, used in the webhook URLs merchants paste into Razorpay
# and Stripe. Gateways must be able to reach it (use a tunnel when testing locally).
# Unset: the admin origin, which forwards /webhooks to the API.
API_PUBLIC_URL=

# --- Email (Mailpit locally: inbox at http://localhost:8025) ------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Workeasy AI Commerce <orders@workeasy.test>
