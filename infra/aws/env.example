# Settings for Workeasy360 Commerce on AWS (docs/deployment.md).
# Store the filled-in file as the Secrets Manager secret
# "workeasy-commerce/production/env", in the EC2 server's region. deploy.sh
# writes it to the server with mode 600 on every deploy. Never commit it.
# Values marked GENERATE: run infra/aws/new-secrets.sh and paste its output.

# --- Addresses ------------------------------------------------------------------
# Until the real domain is ready, sslip.io names resolve to the server's Elastic
# IP with no DNS setup: for 13.233.10.20 use admin.13-233-10-20.sslip.io.
# Later, switch to e.g. admin.workeasy360.com / shop.workeasy360.com (A records
# to the Elastic IP) and redeploy; certificates are issued automatically.
ADMIN_DOMAIN=admin.EIP-WITH-DASHES.sslip.io
STOREFRONT_DOMAIN=shop.EIP-WITH-DASHES.sslip.io
ADMIN_PUBLIC_URL=https://admin.EIP-WITH-DASHES.sslip.io
# Shops live at <this>/s/<slug>; merchants' own domains point here with a CNAME.
STOREFRONT_PUBLIC_URL=https://shop.EIP-WITH-DASHES.sslip.io
# Let's Encrypt writes here about certificates.
ACME_EMAIL=admin@workeasy360.com
LOG_LEVEL=info
WORKER_JOB_CONCURRENCY=8

# --- Database: the shared Aurora/RDS cluster, in a database of its own -----------
# This app gets its own database (workeasy_commerce) and four roles prefixed wec_
# that reach nothing else. Setup marks what it creates and refuses to change any
# database or role it didn't create, so other apps on the cluster are untouched.
# Connections are encrypted and the cluster's certificate is verified.
#
# DATABASE_ADMIN_URL is needed only for the first deploy (it creates the database
# and roles) and when you change a role password. Use the cluster's master user,
# then delete this line from the secret: without it, deploys only migrate.
DATABASE_ADMIN_URL=postgres://MASTER_USER:MASTER_PASSWORD@CLUSTER_ENDPOINT:5432/postgres?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
# Role names are fixed (packages/database/src/roles.ts); the passwords are GENERATE.
DATABASE_MIGRATION_URL=postgres://wec_owner:GENERATE@CLUSTER_ENDPOINT:5432/workeasy_commerce?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
DATABASE_URL=postgres://wec_api:GENERATE@CLUSTER_ENDPOINT:5432/workeasy_commerce?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
DATABASE_WORKER_URL=postgres://wec_worker:GENERATE@CLUSTER_ENDPOINT:5432/workeasy_commerce?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
DATABASE_PUBLIC_URL=postgres://wec_public:GENERATE@CLUSTER_ENDPOINT:5432/workeasy_commerce?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem

# --- Files: Amazon S3 through the server's IAM role (no keys) --------------------
# Three private buckets in the server's region (docs/deployment.md).
OBJECT_STORAGE_REGION=ap-southeast-1
OBJECT_STORAGE_BUCKET_QUARANTINE=workeasy-commerce-quarantine-ACCOUNT_ID
OBJECT_STORAGE_BUCKET_MEDIA=workeasy-commerce-media-ACCOUNT_ID
OBJECT_STORAGE_BUCKET_EXPORTS=workeasy-commerce-exports-ACCOUNT_ID

# --- Sign-in ------------------------------------------------------------------------
# Email and password only for now. Later, the shared Workeasy360 account
# (workeasy360.com) plugs in here as an OpenID Connect provider: set all three.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=GENERATE
SESSION_TTL_HOURS=12
# Encrypts merchants' Razorpay/Stripe keys. Never change it on a running installation.
SECRETS_ENCRYPTION_KEY=GENERATE
# Where Razorpay and Stripe send webhooks. Empty: the admin address, which forwards /webhooks.
API_PUBLIC_URL=

# --- Email: Amazon SES (SMTP interface) ------------------------------------------
# SES console -> SMTP settings -> Create SMTP credentials. The sender's domain
# (workeasy360.com) must be verified in SES and the account out of the sandbox.
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SES_SMTP_USERNAME
SMTP_PASSWORD=SES_SMTP_PASSWORD
MAIL_FROM=Workeasy360 Commerce <no-reply@workeasy360.com>

# --- AI Studio ------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=YOUR_GEMINI_KEY
OPENAI_API_KEY=
# Generations per store per day.
AI_DAILY_LIMIT=3
